# Copiar a .env y cambiar los valores. Nunca versionar el .env real.
NODE_ENV=development
PORT=3001

# Lista separada por comas
CORS_ORIGINS=http://localhost:3000

# Opcional. Numero de proxies delante del servicio (ej. 1) o subred de confianza.
# TRUST_PROXY=1

# En Docker, compose reemplaza estas DB_* con los valores de postgres del .env de la raiz.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=securetalk_auth
DB_PASSWORD=CAMBIAR_contrasena_larga
DB_DATABASE=securetalk_auth
DB_SSL=false

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_MS=60000

# Solo los usa `npm run seed` (usuario ADMIN inicial).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CAMBIAR_contrasena_larga
SEED_ADMIN_CEDULA=0000000000
SEED_ADMIN_NOMBRES=Administrador
SEED_ADMIN_APELLIDOS=Inicial
SEED_ADMIN_FECHA_NACIMIENTO=1990-01-01
