# Copiar a .env y cambiar los valores. Nunca versionar el .env real.
NODE_ENV=development
PORT=3001

# Lista separada por comas
CORS_ORIGINS=http://localhost:3000

# Opcional. Numero de proxies delante del servicio (ej. 1) o subred de confianza.
# TRUST_PROXY=1

# En Docker, compose reemplaza estas DB_* con los valores de postgres del .env de la raiz.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=securetalk_auth
DB_PASSWORD=CAMBIAR_contrasena_larga
DB_DATABASE=securetalk_auth
DB_SSL=false

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_MS=60000

# Llaves Ed25519: generarlas con `node scripts/generate-jwt-keys.mjs` desde la raiz.
# En Docker, compose reemplaza estas rutas por las de los archivos montados.
JWT_PRIVATE_KEY_PATH=../keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../keys/jwt_public.pem
JWT_ISSUER=securetalk-auth
JWT_AUDIENCE=securetalk-api
# Maximo 900 (15 minutos)
JWT_EXPIRES_IN_SECONDS=900

# Secreto compartido con STEGO, de al menos 32 caracteres. Debe ser igual en ambos servicios.
# Generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STEGO_SERVICE_KEY=CAMBIAR_clave_de_servicio_de_al_menos_32_caracteres

# Canal interno con STEGO: generar con `node scripts/generate-internal-cert.mjs` desde la raiz.
# En Docker, compose define las rutas. Fuera de Docker es opcional, salvo con NODE_ENV=production.
# INTERNAL_TLS_CERT_PATH=../keys/internal/auth.crt
# INTERNAL_TLS_KEY_PATH=../keys/internal/auth.key
# INTERNAL_TLS_PORT=3443

# Solo los usa `npm run seed` (usuario ADMIN inicial).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CAMBIAR_contrasena_larga
SEED_ADMIN_CEDULA=0000000000
SEED_ADMIN_NOMBRES=Administrador
SEED_ADMIN_APELLIDOS=Inicial
SEED_ADMIN_FECHA_NACIMIENTO=1990-01-01
