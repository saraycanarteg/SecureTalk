# Copiar a .env y cambiar los valores. Nunca versionar el .env real.
NODE_ENV=development
PORT=3002

# Base de datos propia de STEGO. En Docker, compose reemplaza estas DB_*
# con los valores de stego-db definidos en el .env de la raiz.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=securetalk_stego
DB_PASSWORD=CAMBIAR_contrasena_larga
DB_DATABASE=securetalk_stego
DB_SSL=false

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_MS=60000

# Verificacion local de los JWT emitidos por AUTH. Deben coincidir con los valores de AUTH.
JWT_PUBLIC_KEY_PATH=../keys/jwt_public.pem
JWT_ISSUER=securetalk-auth
JWT_AUDIENCE=securetalk-api

# Autorizacion contra AUTH. En Docker, compose usa http://auth-service:3001
AUTH_BASE_URL=http://localhost:3001
# Minimo 32 caracteres. Generar uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STEGO_SERVICE_KEY=CAMBIAR_clave_de_servicio_de_al_menos_32_caracteres
AUTH_TIMEOUT_MS=3000
# real: consulta a AUTH en cada operacion.
# mock: permite la operacion con cualquier JWT valido. Solo desarrollo:
# con NODE_ENV=production el servicio se niega a arrancar.
AUTHZ_MODE=real

# En Docker, compose usa el volumen montado en /app/uploads
UPLOAD_DIR=./uploads
