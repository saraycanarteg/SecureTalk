# Variables que docker compose lee al interpolar docker-compose.yml.
# Copiar a .env y cambiar los valores. Son las credenciales de Postgres dentro de Docker.
POSTGRES_USER=securetalk_auth
POSTGRES_PASSWORD=CAMBIAR_contrasena_larga
POSTGRES_DB=securetalk_auth

# Puertos publicados en 127.0.0.1
AUTH_PORT=3001
STEGO_PORT=3002
