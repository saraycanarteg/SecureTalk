# Token compartido con el backend (mínimo 32 caracteres).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# En producción usar STEGO_INTERNAL_TOKEN_FILE apuntando a un Docker secret.
STEGO_INTERNAL_TOKEN=
# STEGO_INTERNAL_TOKEN_FILE=/run/secrets/stego_internal_token

STEGO_MAX_FILE_SIZE_MB=10
STEGO_LOG_LEVEL=INFO
