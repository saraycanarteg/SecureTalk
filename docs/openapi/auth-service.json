  "info": {
    "title": "SecureTalk AUTH",
    "description": "Autenticacion con Argon2id y JWT firmado con EdDSA (Ed25519)",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "service-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Key"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin",
            "minLength": 1,
            "maxLength": 50
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT firmado con EdDSA (Ed25519)"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Vigencia del token en segundos"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message",
          "requestId"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "nombres": {
            "type": "string"
          },
          "apellidos": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "nombres",
          "apellidos"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "cedula": {
            "type": "string",
            "example": "1710034065",
            "description": "Cedula ecuatoriana: provincia, tercer digito y digito verificador"
          },
          "nombres": {
            "type": "string",
            "example": "Ana Maria",
            "maxLength": 100
          },
          "apellidos": {
            "type": "string",
            "example": "Perez Lopez",
            "maxLength": 100
          },
          "fechaNacimiento": {
            "type": "string",
            "example": "1990-01-31",
            "format": "date"
          },
          "username": {
            "type": "string",
            "example": "ana.perez",
            "minLength": 3,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "maxLength": 150
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128,
            "description": "Al menos 3 de 4 tipos: minuscula, mayuscula, digito y simbolo"
          }
        },
        "required": [
          "cedula",
          "nombres",
          "apellidos",
          "fechaNacimiento",
          "username",
          "email",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cedula": {
            "type": "string"
          },
          "nombres": {
